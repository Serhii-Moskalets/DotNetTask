{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",

    "FrontendSettings": {
        "BaseUrl": "http://localhost:3000"
    },

    "ConnectionStrings": {
        "DefaultConnection": ""
    },

    "DatabaseSettings": {
        "MaxRetryCount": 5,
        "MaxRetryDelaySeconds": 10,
        "CommandTimeout": 20
    },

    "Serilog": {
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning",
                "Microsoft.AspNetCore": "Warning"
            }
        }
    },

    "EmailSettings": {
        "Host": "smtp.gmail.com",
        "Port": 587,
        "FromEmail": "monsters.inc.verif@gmail.com",
        "FromName": "To-Do App",
        "UserName": "monsters.inc.verif@gmail.com",
        "Password": "",
        "EnableSsl": true
    },

    "JwtSettings": {
        "Secret": "",
        "Issuer": "TodoListApp",
        "Audience": "TodoListApp-Users",
        "ExpiryMinutes": 60
    },

    "Auth": {
        "ResetPasswordEndpoint": "/auth/reset-password"
    }
}
